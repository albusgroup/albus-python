#!/usr/bin/env bash

set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
dist_dir="$repo_root/dist"

usage() {
    cat >&2 <<EOF
usage: $0 [--without-speakeasy]

Lint, type-check, test, build, and smoke-import the wheel.

  --without-speakeasy   Skip the steps that need the Speakeasy CLI and a
                        Speakeasy account. This is what CI runs, since the
                        pinned CLI and its credentials are only available
                        where the SDK is regenerated.
EOF
}

with_speakeasy=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --without-speakeasy)
            with_speakeasy=false
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage
            exit 2
            ;;
    esac
done

cd "$repo_root"
export PATH="$repo_root/bin:$PATH"

required_commands=(uv)
if [[ "$with_speakeasy" == true ]]; then
    required_commands+=(speakeasy)
fi

for command in "${required_commands[@]}"; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "error: required command not found: $command" >&2
        exit 1
    fi
done

if [[ "$with_speakeasy" == true ]]; then
    speakeasy openapi lint \
        --schema openapi/openapi.yaml \
        --non-interactive
fi

uv sync --all-groups --frozen
uv run ruff format --check tests tools/*.py
uv run ruff check tests tools/*.py
uv run mypy src/albus_sdk
uv run pyright src/albus_sdk
uv run pytest

rm -rf "$dist_dir"
uv build
uv run twine check dist/*

sdk_version="$(
    sed -n 's/^__version__: str = "\(.*\)"/\1/p' \
        src/albus_sdk/_version.py
)"
uv run --frozen python tools/release_metadata.py \
    artifacts "$sdk_version"

wheel_files=("$dist_dir"/*.whl)
if [[ ${#wheel_files[@]} -ne 1 || ! -f "${wheel_files[0]}" ]]; then
    echo "error: expected exactly one wheel in $dist_dir" >&2
    exit 1
fi

for python_version in 3.10 3.14; do
    uv run \
        --isolated \
        --no-project \
        --python "$python_version" \
        --with "${wheel_files[0]}" \
        python -c \
        'import albus_sdk; from albus_sdk import Albus; assert Albus; print(albus_sdk.VERSION)'
done

echo "All checks passed."
